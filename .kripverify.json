{
  "browser": {
    "user_agent_suffix": "KripVerify/1.0",
    "viewport": {
      "height": 800,
      "width": 1280
    }
  },
  "dev_server": {
    "command": "/bin/bash -lc 'cd kid-kode-landing && npm run dev'",
    "env_file": ".env.local",
    "port_strategy": "auto",
    "ready_pattern": "Local:"
  },
  "verification": {
    "auto_run_on_stop": true,
    "console_severity_threshold": "warning",
    "default_url": "http://localhost:{port}",
    "smoke_routes": [
      "/"
    ]
  },
  "version": 1
}