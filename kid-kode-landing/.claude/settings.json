{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Prism mock-app build — anti-drift hooks enforce mock-spec §1.4 forbidden patterns on every Write/Edit into prism runtime/build code. SessionStart hook announces spec locations.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/spec-presence-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/anti-drift-check.sh"
          }
        ]
      }
    ]
  }
}
