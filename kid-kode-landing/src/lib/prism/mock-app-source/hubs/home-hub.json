      "visual": {
        "sourceAsset": "theme-selector-button",
        "defaultRegion": "default",
        "transform": {
          "x": 780,
          "y": 1770,
          "width": 360,
          "height": 260,
          "z": 51
        },
        "shape": "pill"
      },
      "intent": {
        "caption": "Horizontal pill-shaped machined aluminum toggle on a dark steel substrate. Three states (default / hover / pressed) expressed only through lighting changes. The toggle surface is completely blank with no markings, no inscription, no characters, no letters anywhere.",
        "behaviorSpec": {
          "interactions": [
            {
              "event": "pointerover",
              "effect": "swap-to-hover"
            },
            {
              "event": "pointerout",
              "effect": "swap-to-default"
            },
            {
              "event": "pointerdown",
              "effect": "swap-to-pressed"
            },
            {
              "event": "pointertap",
              "effect": "cycle-theme"
            }
          ],
          "apiCalls": [
            {
              "endpoint": "/api/mock/user-preferences",
              "method": "POST"
            }
          ],
          "dataBindings": [
